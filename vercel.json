{
  "headers": [
    {
      "source": "/archive/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/install",
      "destination": "/docs/arbridge-installation.html"
    },
    {
      "source": "/monday-setup",
      "destination": "/docs/arbridge-monday-setup.html"
    },
    {
      "source": "/blog/post.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "accounts-payable-automation-guide"
        }
      ],
      "destination": "/blog/rendered-accounts-payable-automation-guide.html"
